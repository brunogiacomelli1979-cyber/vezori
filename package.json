{
  "name": "vezori",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "VEZORI: intelig\u00c3\u00aancia de investimentos com dados de mercado reais e carteira de opera\u00c3\u00a7\u00c3\u00b5es audit\u00c3\u00a1veis",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run check && npm run build && node scripts/provision_kv.mjs --required && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs && npm test",
    "build": "node scripts/prepare-assets.mjs",
    "predev": "npm run build",
    "test:ui": "playwright test",
    "test:production": "node tests/production/api.mjs && node tests/production/browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "chart.js": "4.4.8",
    "lightweight-charts": "5.2.1"
  }
}
